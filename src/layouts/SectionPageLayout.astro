---
import BaseLayout from "./BaseLayout.astro";
import PageTopbar from "../components/PageTopbar.astro";
import SiteHeader from "../components/SiteHeader.astro";
import HomeFooter from "../components/HomeFooter.astro";
import { DEFAULT_PAGE_LINKS, SITE_TITLE, buildBreadcrumbJsonLd, mergeKeywords, type SiteLink } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  heading?: string;
  backHref?: string;
  backLabel?: string;
  leftLink?: SiteLink;
  rightLinks?: SiteLink[];
  keywords?: string[];
  noindex?: boolean;
}

const {
  title,
  description,
  heading = title,
  backHref = "/",
  backLabel = "home",
  leftLink = { href: "/", label: "home" },
  rightLinks = DEFAULT_PAGE_LINKS,
  keywords = [],
  noindex = false,
} = Astro.props as Props;

const pathname = Astro.url.pathname;
const routeRoot = pathname.split("/").filter(Boolean)[0] ?? "about";
const theme = routeRoot === "entries" || routeRoot === "lore" ? "wiki" : routeRoot === "tag" ? "neutral" : routeRoot;
const pageKeywords = mergeKeywords([title, heading, ...keywords]);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `${heading} · ${SITE_TITLE}`,
    description,
    url: new URL(pathname, Astro.site).toString(),
    inLanguage: "zh-CN",
    keywords: pageKeywords.join(", "),
  },
  buildBreadcrumbJsonLd([
    { name: "首页", path: "/" },
    { name: heading, path: pathname },
  ]),
];
---

<BaseLayout title={`${title} · ${SITE_TITLE}`} description={description} keywords={pageKeywords} jsonLd={jsonLd} noindex={noindex} bodyClass={`theme-${theme}`}>
  <SiteHeader />
  <main class:list={["page-main", `theme-${theme}`]} id="main-content">
    <header class="page-hero">
      <div class="page-hero__inner">
        <p class="eyebrow eyebrow--light">CETUS ARCHIVE / COLLECTION</p>
        <h1>{heading}</h1>
        {description ? <p>{description}</p> : null}
      </div>
    </header>
    <section class="page-content">
      <PageTopbar leftLink={leftLink} rightLinks={rightLinks} />
      <div class="section-head">
        <h2 class="h2">档案列表</h2>
        <a class="more" href={backHref}>{backLabel}</a>
      </div>
      <slot />
    </section>
  </main>
  <HomeFooter />
</BaseLayout>
