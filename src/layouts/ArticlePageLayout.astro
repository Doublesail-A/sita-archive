---
import BaseLayout from "./BaseLayout.astro";
import PageTopbar from "../components/PageTopbar.astro";
import SiteHeader from "../components/SiteHeader.astro";
import HomeFooter from "../components/HomeFooter.astro";
import { SITE_TITLE, buildBreadcrumbJsonLd, mergeKeywords } from "../lib/site";

interface Props {
  title: string;
  description?: string;
  metaLabel?: string;
  metaValue?: string;
  backHref?: string;
  publishedTime?: string;
  modifiedTime?: string;
  tags?: string[];
  cover?: string;
  showCover?: boolean;
  schemaType?: string;
}

const layoutProps = (Astro.props.frontmatter ?? Astro.props) as Props;

const {
  title,
  description,
  metaLabel,
  metaValue,
  backHref = "/",
  publishedTime,
  modifiedTime,
  tags = [],
  cover,
  showCover = true,
  schemaType = "Article",
} = layoutProps;

const pathname = Astro.url.pathname;
const routeRoot = pathname.split("/").filter(Boolean)[0] ?? "about";
const theme = routeRoot === "entries" || routeRoot === "lore" ? "wiki" : routeRoot === "tag" ? "neutral" : routeRoot;
const pageKeywords = mergeKeywords([title, ...tags]);
const crumbs = [
  { name: "首页", path: "/" },
  ...(backHref !== "/" ? [{ name: routeRoot.toUpperCase(), path: backHref }] : []),
  { name: title, path: pathname },
];
const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": schemaType,
  headline: title,
  description,
  url: new URL(pathname, Astro.site).toString(),
  inLanguage: "zh-CN",
  datePublished: publishedTime,
  dateModified: modifiedTime ?? publishedTime,
  image: cover ? [new URL(cover, Astro.site).toString()] : undefined,
  keywords: pageKeywords.join(", "),
  mainEntityOfPage: new URL(pathname, Astro.site).toString(),
};
const jsonLd = [articleJsonLd, buildBreadcrumbJsonLd(crumbs)];
---

<BaseLayout
  title={`${title} · ${SITE_TITLE}`}
  description={description}
  keywords={pageKeywords}
  image={cover}
  ogType="article"
  publishedTime={publishedTime}
  modifiedTime={modifiedTime}
  jsonLd={jsonLd}
  bodyClass={`theme-${theme}`}
>
  <SiteHeader />
  <main class:list={["article-page", `theme-${theme}`]} id="main-content">
    <div class="article-wrap"><PageTopbar leftLink={{ href: backHref, label: "BACK" }} /></div>
    <article class="article">
      <header class="article-head">
        <div class="article-wrap">
          <p class="eyebrow">CETUS ARCHIVE / RECORD</p>
          <h1 class="article-title">{title}</h1>
          {metaLabel ? <div class="article-meta"><span class="article-date">{metaLabel}：{metaValue ?? "—"}</span></div> : null}
          {description ? <p class="article-desc">{description}</p> : null}
        </div>
      </header>
      {cover && showCover ? <img class="article-cover" src={cover} alt="" /> : null}
      <div class="article-wrap">
        <div class="prose"><slot /></div>
        <footer class="article-foot"><a class="pill-ink" href={backHref}>BACK</a></footer>
      </div>
    </article>
  </main>
  <HomeFooter />
</BaseLayout>
