---
import footImg from "../img/foot.webp";
import { toAssetSrc } from "../lib/format";
import { FOOTER_LINKS, OWNER_EMAIL } from "../lib/site";

const socialLinks = [
  { href: "https://space.bilibili.com/3493270525053175", label: "Bilibili", icon: "bilibili" },
  { href: "https://m.weibo.cn/u/7830139417", label: "Weibo", icon: "weibo" },
  { href: "https://x.com/Cetus_42", label: "X", icon: "x" },
  { href: "https://www.youtube.com/@Cetus-42", label: "YouTube", icon: "youtube" },
  { href: "https://www.instagram.com/cetus__42", label: "Instagram", icon: "instagram" },
];
---

<footer class="footer">
  <div class="footer-visual" data-reveal>
    <img class="footer-img" src={toAssetSrc(footImg)} alt="云海中的城邦" loading="lazy" />
    <span class="footer-visual__word" aria-hidden="true">CETUS</span>
  </div>
  <div class="footer-content">
    <div class="footer-main">
      <h2>自天空坠落云海，<br />随潮汐回归彼岸</h2>
      <nav class="footer-links" aria-label="页脚导航">
        {FOOTER_LINKS.map((link) => <a href={link.href}>{link.label}<span>↗</span></a>)}
      </nav>
    </div>
    <div class="footer-social" aria-label="汐塔官方社交平台">
      <span class="footer-social__label">官方社媒</span>
      {socialLinks.map((link) => (
        <a href={link.href} target="_blank" rel="noreferrer" aria-label={link.label} title={link.label}>
          {link.icon === "bilibili" ? (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.4 3.1 10 5.7h4l2.6-2.6 1.2 1.2-1.4 1.4H18A3 3 0 0 1 21 8.8v8.4a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8.8a3 3 0 0 1 3-3h1.6L6.2 4.3l1.2-1.2ZM6 7.6c-.7 0-1.2.5-1.2 1.2v8.4c0 .7.5 1.2 1.2 1.2h12c.7 0 1.2-.5 1.2-1.2V8.8c0-.7-.5-1.2-1.2-1.2H6Zm2.4 3.3c.6 0 1 .5 1 1.1v1.5c0 .6-.4 1.1-1 1.1s-1-.5-1-1.1V12c0-.6.4-1.1 1-1.1Zm7.2 0c.6 0 1 .5 1 1.1v1.5c0 .6-.4 1.1-1 1.1s-1-.5-1-1.1V12c0-.6.4-1.1 1-1.1Z"/></svg>
          ) : link.icon === "weibo" ? (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M17.8 11.2c-.5-.2-.8-.3-.6-.9.5-1.1.6-2.1 0-2.7-1.1-1.1-4.2 0-7 2.4-2.1 1.8-3.4 3.7-3.4 5.4 0 3 3.9 4.8 7.6 4.8 4.9 0 8.1-2.8 8.1-5.1 0-1.4-1.2-2.9-4.7-3.9Zm-3.3 7.4c-2.5.3-4.7-.8-4.9-2.5-.2-1.8 1.7-3.5 4.2-3.8s4.8.7 5 2.4c.2 1.8-1.8 3.5-4.3 3.9Zm-1.3-4.5c-1.3.3-2.2 1.3-2 2.3.2 1.1 1.4 1.7 2.7 1.4 1.3-.3 2.2-1.3 2-2.3-.2-1-1.4-1.7-2.7-1.4Zm.2 2.5c-.4.2-.9.1-1.1-.2-.2-.4 0-.8.4-1 .4-.2.9-.1 1.1.2.2.4 0 .8-.4 1Zm5.4-12.4a6 6 0 0 1 5.2 6.7l-1.8-.2a4.2 4.2 0 0 0-3.6-4.7l.2-1.8Zm-.5 3.1a3 3 0 0 1 2.6 3.4l-1.6-.2a1.4 1.4 0 0 0-1.2-1.6l.2-1.6Z"/></svg>
          ) : link.icon === "x" ? (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.2 3h4.4l4.3 5.8L17.9 3h1.9l-6 7.2L20.3 21h-4.4l-4.7-6.3L5.8 21H3.9l6.4-7.7L4.2 3Zm3.5 1.7 9 14.6h1.8l-9-14.6H7.7Z"/></svg>
          ) : link.icon === "youtube" ? (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M22 7.4a3 3 0 0 0-2.1-2.1C18 4.8 12 4.8 12 4.8s-6 0-7.9.5A3 3 0 0 0 2 7.4 31 31 0 0 0 1.5 12 31 31 0 0 0 2 16.6a3 3 0 0 0 2.1 2.1c1.9.5 7.9.5 7.9.5s6 0 7.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.6 31 31 0 0 0-.5-4.6ZM9.8 15.1V8.9l5.4 3.1-5.4 3.1Z"/></svg>
          ) : (
            <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M7.2 2h9.6A5.2 5.2 0 0 1 22 7.2v9.6a5.2 5.2 0 0 1-5.2 5.2H7.2A5.2 5.2 0 0 1 2 16.8V7.2A5.2 5.2 0 0 1 7.2 2Zm-.1 2A3.1 3.1 0 0 0 4 7.1v9.8A3.1 3.1 0 0 0 7.1 20h9.8a3.1 3.1 0 0 0 3.1-3.1V7.1A3.1 3.1 0 0 0 16.9 4H7.1Zm10.2 1.5a1.2 1.2 0 1 1 0 2.4 1.2 1.2 0 0 1 0-2.4ZM12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10Zm0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z"/></svg>
          )}
        </a>
      ))}
    </div>
    <div class="footer-meta">
      <span>非官方同人站点</span>
      <a href={`mailto:${OWNER_EMAIL}`}>CONTACT ↗</a>
      <span>© 2026 CETUS WIKI</span>
    </div>
  </div>
</footer>
