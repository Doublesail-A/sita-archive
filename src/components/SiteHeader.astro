---
import { DEFAULT_PAGE_LINKS } from "../lib/site";

interface Props {
  overlay?: boolean;
}

const { overlay = false } = Astro.props as Props;
---

<header class:list={["site-header", overlay && "site-header--overlay"]} data-site-header>
  <a class="skip-link" href="#main-content">跳到正文</a>
  <div class="site-header__inner">
    <a class="site-brand" href="/" aria-label="汐塔 Cetus 首页">
      <span class="site-brand__mark">CETUS</span>
    </a>

    <nav class="site-nav" aria-label="主导航">
      {DEFAULT_PAGE_LINKS.map((link) => (
        <a href={link.href}>{link.label}</a>
      ))}
    </nav>

    <div class="site-header__actions">
      <a class="official-link" href="https://space.bilibili.com/3493270525053175/dynamic" target="_blank" rel="noreferrer">
        OFFICIAL <span aria-hidden="true">↗</span>
      </a>
      <details class="mobile-menu" data-mobile-menu>
        <summary aria-label="打开导航菜单" aria-controls="site-mobile-nav" aria-expanded="false"><span></span><span></span></summary>
        <nav id="site-mobile-nav" aria-label="移动端导航">
          {DEFAULT_PAGE_LINKS.map((link) => (
            <a href={link.href}>{link.label}</a>
          ))}
          <a href="https://space.bilibili.com/3493270525053175/dynamic" target="_blank" rel="noreferrer">OFFICIAL ↗</a>
        </nav>
      </details>
    </div>
  </div>
</header>

<script>
  const menu = document.querySelector<HTMLDetailsElement>("[data-mobile-menu]");
  const trigger = menu?.querySelector<HTMLElement>("summary");
  let closeTimer = 0;
  let openFrame = 0;

  const closeMenu = () => {
    if (!menu?.open || menu.classList.contains("is-closing")) return;
    window.clearTimeout(closeTimer);
    window.cancelAnimationFrame(openFrame);
    menu.classList.add("is-closing");
    menu.classList.remove("is-expanded");
    trigger?.setAttribute("aria-expanded", "false");
    closeTimer = window.setTimeout(() => {
      menu.removeAttribute("open");
      menu.classList.remove("is-closing");
    }, 720);
  };

  trigger?.addEventListener("click", (event) => {
    if (!menu?.open) return;
    event.preventDefault();
    closeMenu();
  });

  menu?.addEventListener("toggle", () => {
    if (!menu.open) {
      menu.classList.remove("is-expanded");
      trigger?.setAttribute("aria-expanded", "false");
      return;
    }
    menu.classList.remove("is-closing");
    trigger?.setAttribute("aria-expanded", "true");
    window.cancelAnimationFrame(openFrame);
    openFrame = window.requestAnimationFrame(() => {
      openFrame = window.requestAnimationFrame(() => menu.classList.add("is-expanded"));
    });
  });

  document.addEventListener("click", (event) => {
    if (!menu?.open || menu.contains(event.target as Node)) return;
    closeMenu();
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !menu?.open) return;
    closeMenu();
    trigger?.focus();
  });
</script>
