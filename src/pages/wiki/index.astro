---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageTopbar from "../../components/PageTopbar.astro";
import SiteHeader from "../../components/SiteHeader.astro";
import HomeFooter from "../../components/HomeFooter.astro";
import { getCollectionCards } from "../../lib/content";
import { formatDate } from "../../lib/format";
import { DEFAULT_PAGE_LINKS, SITE_TITLE, buildBreadcrumbJsonLd, mergeKeywords } from "../../lib/site";

const entries = await getCollectionCards("wiki");
const items = entries.map((entry) => ({
  title: entry.title,
  desc: entry.description ?? "",
  date: formatDate(entry.date),
  url: entry.url,
  cover: entry.cover,
  hasPreview: entry.hasPreview,
}));

const pageKeywords = mergeKeywords(["汐塔wiki", "汐塔同人", "潮汐之塔", "云海逐鲸"]);
const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: `Wiki · ${SITE_TITLE}`,
    description: "汐塔世界观条目索引。",
    url: new URL(Astro.url.pathname, Astro.site).toString(),
    inLanguage: "zh-CN",
    keywords: pageKeywords.join(", "),
  },
  buildBreadcrumbJsonLd([
    { name: "首页", path: "/" },
    { name: "wiki", path: "/wiki/" },
  ]),
];
---

<BaseLayout title={`Wiki · ${SITE_TITLE}`} description="汐塔世界观条目索引。" keywords={pageKeywords} jsonLd={jsonLd}>
  <SiteHeader />
  <main class="wiki-page" id="main-content">
    <header class="page-hero">
      <div class="page-hero__inner">
        <p class="eyebrow eyebrow--light">FIELD GUIDE / WORLD ARCHIVE</p>
        <h1>世界档案</h1>
        <p>从云海、潮汐与鲸开始，检索这个世界的地点、职业、设备和生物。</p>
      </div>
    </header>
    <div class="page-content">
      <PageTopbar leftLink={{ href: "/", label: "返回首页" }} rightLinks={DEFAULT_PAGE_LINKS} />
      <section class="page-head">
      <p class="eyebrow">SEARCH {items.length} RECORDS</p>

      <div class="wiki-search">
        <input
          id="wikiSearchInput"
          class="wiki-search__input"
          type="search"
          placeholder="搜索条目…（例如：云海 / 捕鲸 / 潮汐塔）"
          autocomplete="off"
          inputmode="search"
        />
        <button id="wikiSearchClear" class="wiki-search__clear" type="button">清除</button>
      </div>

      <div id="wikiSearchHint" class="wiki-search__hint">共 {items.length} 条</div>
      </section>

      <section class="wiki-index" id="wikiIndex">
      {items.length === 0 ? (
        <div class="empty-note">这里还没有 wiki 条目。</div>
      ) : (
        items.map((item) => (
          <a class="wiki-row" href={item.url}>
            <div class="wiki-row__date">{item.date}</div>
            <div class="wiki-row__main">
              {item.hasPreview && item.cover ? (
                <div class="wiki-row__cover-shell">
                  <img class="wiki-row__cover" src={item.cover} alt="" loading="lazy" />
                </div>
              ) : null}
              <div class="wiki-row__title">{item.title}</div>
              {item.desc ? <div class="wiki-row__desc">{item.desc}</div> : null}
            </div>
            <div class="wiki-row__arrow">↗</div>
          </a>
        ))
      )}
      </section>

      <script id="wikiIndexData" type="application/json" set:html={JSON.stringify(items)}></script>
      <script src="/scripts/wiki-index.js" defer></script>
    </div>
  </main>
  <HomeFooter />
</BaseLayout>
