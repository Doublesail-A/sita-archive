---
import SectionPageLayout from "../layouts/SectionPageLayout.astro";
import poster from "../img/music/01.webp";

const songs = ["628812162", "628811598", "628812391", "628812135"];
const qqOpenUrl = "https://i.y.qq.com/v8/playsong.html?songid=628812162&songtype=0#webchat_redirect";
const neteaseUrl = "https://music.163.com/#/playlist?id=182062991";
const qqOutchainSrc = (songid: string) => `https://i.y.qq.com/n2/m/outchain/player/index.html?songid=${songid}&songtype=0`;
---

<SectionPageLayout title="MUSIC" description="概念短片中的音乐与云海歌单。外部播放器可能需要稍候加载。" heading="MUSIC" backLabel="HOME">
  <section class="music-shell">
    <figure class="music-art"><img src={poster.src} alt="汐塔声音档案封面" /></figure>
    <div class="music-list">
      {songs.map((id, idx) => (
        <div class="track">
          <span>TRACK {String(idx + 1).padStart(2, "0")}</span>
          <iframe title={`QQ Music Player ${idx + 1}`} src={qqOutchainSrc(id)} frameborder="0" allow="encrypted-media" loading="lazy"></iframe>
        </div>
      ))}
      <div class="music-links">
        <a href={qqOpenUrl} target="_blank" rel="noreferrer">在 QQ 音乐打开 ↗</a>
        <a href={neteaseUrl} target="_blank" rel="noreferrer">在网易云音乐打开 ↗</a>
      </div>
    </div>
  </section>
  <style>
    .music-shell{display:grid;grid-template-columns:minmax(280px,.8fr) minmax(0,1.2fr);gap:36px;align-items:start}
    .music-art{position:sticky;top:24px;margin:0;border:1px solid var(--line)}
    .music-art img{width:100%}
    .music-list{border-top:1px solid var(--line)}
    .track{padding:20px 0;border-bottom:1px solid var(--line)}
    .track>span{display:block;margin-bottom:10px;font:700 .62rem/1 var(--sans);letter-spacing:.15em;color:var(--ink-soft)}
    .track iframe{width:100%;height:76px;border:1px solid var(--line);background:rgba(255,255,255,.45)}
    .music-links{display:flex;flex-wrap:wrap;gap:10px;margin-top:20px}
    .music-links a{padding:12px 16px;border:1px solid var(--ink);font-size:.7rem;font-weight:700;letter-spacing:.08em}
    @media(max-width:760px){.music-shell{grid-template-columns:1fr}.music-art{position:static}}
  </style>
</SectionPageLayout>
