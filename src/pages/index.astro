---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import HomeFooter from "../components/HomeFooter.astro";
import { getCollectionCards, getMovieEntries } from "../lib/content";
import { formatDate, toAssetSrc } from "../lib/format";
import { SITE_DESCRIPTION, SITE_KEYWORDS, SITE_TITLE, buildBreadcrumbJsonLd } from "../lib/site";

import heroDesktop from "../img/main/desktop/03.webp";
import heroMobile from "../img/main/mobile/08.webp";
import worldImage from "../img/main/desktop/01.webp";
import logoInline from "../img/logo/logo.svg?raw";

const [news, movies, entries, wiki, doujin] = await Promise.all([
  getCollectionCards("news"),
  getMovieEntries(),
  getCollectionCards("entries"),
  getCollectionCards("wiki"),
  getCollectionCards("doujin"),
]);

const latestNews = news.slice(0, 4);
const featuredMovies = movies.slice(0, 3);
const coreEntries = entries.filter((entry) => ["云海", "鲸鱼", "潮汐塔"].some((name) => entry.title.includes(name))).slice(0, 3);
const worldEntries = coreEntries.length === 3 ? coreEntries : entries.slice(0, 3);
const archiveCount = wiki.length + doujin.length + news.length;

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: SITE_TITLE,
    description: SITE_DESCRIPTION,
    url: new URL(Astro.url.pathname, Astro.site).toString(),
    inLanguage: "zh-CN",
    keywords: SITE_KEYWORDS.join(", "),
  },
  buildBreadcrumbJsonLd([{ name: "首页", path: "/" }]),
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} keywords={SITE_KEYWORDS} jsonLd={jsonLd} bodyClass="home-page">
  <SiteHeader overlay />

  <main id="main-content">
    <section class="home-hero" id="top">
      <picture class="home-hero__media">
        <source media="(max-width: 760px)" srcset={toAssetSrc(heroMobile)} />
        <img src={toAssetSrc(heroDesktop)} alt="云海之上的汐塔世界" fetchpriority="high" />
      </picture>
      <div class="home-hero__wash" aria-hidden="true"></div>
      <div class="home-hero__coordinates" aria-hidden="true">
        <span>25°00′ N</span><span>CETUS / 42</span><span>SIGNAL 08</span>
      </div>
      <div class="home-hero__content">
        <p class="eyebrow eyebrow--light">UNOFFICIAL WORLD &amp; CREATION ARCHIVE</p>
        <div class="home-hero__logo" set:html={logoInline} aria-label="汐塔"></div>
        <p class="home-hero__lead">自天空坠落云海，<br />随潮汐回归彼岸。</p>
        <div class="home-hero__actions">
          <a class="button button--light" href="#dispatch">接收最新航报</a>
          <a class="button button--ghost" href="/wiki/">进入世界档案</a>
        </div>
      </div>
      <div class="home-hero__signal" aria-hidden="true">
        <span class="home-hero__signal-no">042</span>
        <span>LISTENING<br />ABOVE THE CLOUD SEA</span>
      </div>
      <a class="scroll-cue" href="#dispatch"><span></span>SCROLL TO DESCEND</a>
    </section>

    <aside class="dispatch-strip" id="dispatch" aria-label="最新动态">
      <span class="dispatch-strip__label">LATEST SIGNAL</span>
      <a href="https://space.bilibili.com/3493270525053175/dynamic" target="_blank" rel="noreferrer">
        <time datetime="2026-04-28">2026.04.28</time>
        <strong>《汐塔》×《科幻世界》全民共创计划正式启动</strong>
        <span>查看官方动态 ↗</span>
      </a>
    </aside>

    <section class="intro-section section-pad">
      <div class="intro-section__index" aria-hidden="true">01 / WORLD</div>
      <div class="intro-section__copy">
        <p class="eyebrow">WELCOME ABOVE THE CLOUD SEA</p>
        <h1>繁荣纪元已经远去。<br />孤岛之上，文明仍在呼吸。</h1>
        <p>巨鲸在剧毒云海中逡巡，潮汐塔监听来自深处的信号，探险者从高地城邦驶向未知。本档案站整理《汐塔》的公开设定、影像与爱好者创作，邀请你从任意一条航线进入这个柴油朋克世界。</p>
      </div>
      <dl class="intro-section__facts">
        <div><dt>42</dt><dd>档案识别码</dd></div>
        <div><dt>{wiki.length}</dt><dd>世界观条目</dd></div>
        <div><dt>{archiveCount}</dt><dd>已收录记录</dd></div>
      </dl>
    </section>

    <section class="news-section section-pad" aria-labelledby="news-title">
      <header class="section-title">
        <div><span>02</span><p class="eyebrow">DISPATCH / 航报</p></div>
        <h2 id="news-title">云海来信</h2>
        <a href="/news/">全部航报 <span>↗</span></a>
      </header>
      <div class="news-grid">
        {latestNews.map((item, index) => (
          <a class:list={["signal-card", index === 0 && "signal-card--lead"]} href={item.url}>
            {item.cover ? <img src={item.cover} alt="" loading="lazy" /> : <div class="signal-card__pattern" aria-hidden="true"></div>}
            <div class="signal-card__body">
              <div class="signal-card__meta"><time>{formatDate(item.date)}</time><span>NO.{String(news.length - index).padStart(3, "0")}</span></div>
              <h3>{item.title}</h3>
              {item.description ? <p>{item.description}</p> : null}
              <span class="signal-card__arrow">READ SIGNAL ↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="film-section" aria-labelledby="film-title">
      <div class="film-section__backdrop" aria-hidden="true"></div>
      <div class="film-section__inner section-pad">
        <header class="section-title section-title--light">
          <div><span>03</span><p class="eyebrow eyebrow--light">MOVING IMAGE / 影像</p></div>
          <h2 id="film-title">影像档案</h2>
          <a href="https://space.bilibili.com/3493270525053175/upload" target="_blank" rel="noreferrer">官方投稿 ↗</a>
        </header>
        <div class="film-grid">
          {featuredMovies.map((movie, index) => (
            <a class:list={["film-card", index === 0 && "film-card--main"]} href={movie.link} target="_blank" rel="noreferrer">
              <div class="film-card__image">
                <img src={movie.cover} alt={movie.title} loading="lazy" />
                <span class="film-card__play" aria-hidden="true">▶</span>
                <span class="film-card__number">0{index + 1}</span>
              </div>
              <div class="film-card__info">
                <time>{formatDate(movie.date)}</time>
                <h3>{movie.title}</h3>
                {movie.description ? <p>{movie.description}</p> : null}
              </div>
            </a>
          ))}
          {featuredMovies.length < 3 ? (
            <a class="film-card film-card--note" href="https://space.bilibili.com/3493270525053175/upload" target="_blank" rel="noreferrer">
              <span>70+</span>
              <div><p class="eyebrow eyebrow--light">OFFICIAL CHANNEL</p><h3>继续接收云海影像</h3><b>前往汐塔工作室投稿页 ↗</b></div>
            </a>
          ) : null}
        </div>
      </div>
    </section>

    <section class="world-section section-pad" aria-labelledby="world-title">
      <header class="section-title">
        <div><span>04</span><p class="eyebrow">FIELD GUIDE / 世界</p></div>
        <h2 id="world-title">从这里认识汐塔</h2>
        <a href="/wiki/">浏览全部词条 ↗</a>
      </header>
      <div class="world-feature">
        <div class="world-feature__image">
          <img src={toAssetSrc(worldImage)} alt="潮汐塔与探险者" loading="lazy" />
          <span>OBSERVATION SITE / OCT.07</span>
        </div>
        <div class="world-feature__entries">
          {worldEntries.map((entry, index) => (
            <a href={entry.url}>
              <span>0{index + 1}</span>
              <div><h3>{entry.title}</h3><p>{entry.summary ?? entry.description ?? "打开档案阅读完整记录。"}</p></div>
              <b aria-hidden="true">↗</b>
            </a>
          ))}
          <a class="world-feature__all" href="/entries/">打开核心设定索引 <b>↗</b></a>
        </div>
      </div>
    </section>

    <section class="cocreate-section">
      <div class="cocreate-section__inner section-pad">
        <p class="eyebrow eyebrow--light">OPEN CALL · 云海之上，孤岛新生</p>
        <h2>你笔下的故事，<br />也可以成为云海的历史。</h2>
        <p>2026 年，《汐塔》携手《科幻世界》开启全民共创计划。这里也持续收录世界观延伸、小说、设定和旅途片段。</p>
        <div class="cocreate-section__actions">
          <a class="button button--warm" href="https://space.bilibili.com/3493270525053175/dynamic" target="_blank" rel="noreferrer">查看官方计划 ↗</a>
          <a class="button button--ghost" href="/doujin/">阅读同人创作</a>
        </div>
      </div>
      <div class="cocreate-section__stamp" aria-hidden="true"><span>CETUS</span><b>共创</b><small>ARCHIVE 42</small></div>
    </section>

    <section class="archive-section section-pad" aria-labelledby="archive-title">
      <header class="section-title">
        <div><span>05</span><p class="eyebrow">ARCHIVE MAP / 索引</p></div>
        <h2 id="archive-title">选择你的航线</h2>
      </header>
      <div class="archive-grid">
        <a href="/wiki/"><span>01</span><h3>世界档案</h3><p>地点、设备、职业与生物设定。</p><b>WIKI ↗</b></a>
        <a href="/doujin/"><span>02</span><h3>共创作品</h3><p>来自云海旅人的小说与设定延伸。</p><b>DOUJIN ↗</b></a>
        <a href="/music"><span>03</span><h3>声音档案</h3><p>从概念短片延伸出的原声与歌单。</p><b>MUSIC ↗</b></a>
        <a href="/about/"><span>04</span><h3>关于本站</h3><p>资料来源、投稿方式与维护说明。</p><b>ABOUT ↗</b></a>
      </div>
    </section>
  </main>

  <HomeFooter />
</BaseLayout>
