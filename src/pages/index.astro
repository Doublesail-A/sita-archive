---
import BaseLayout from "../layouts/BaseLayout.astro";
import SiteHeader from "../components/SiteHeader.astro";
import HomeFooter from "../components/HomeFooter.astro";
import { getCollectionCards, getMovieEntries } from "../lib/content";
import { formatDate, toAssetSrc } from "../lib/format";
import { SITE_DESCRIPTION, SITE_KEYWORDS, SITE_TITLE, buildBreadcrumbJsonLd } from "../lib/site";

import heroDesktop from "../img/main/desktop/03.webp";
import heroMobile from "../img/main/mobile/08.webp";
import worldImage from "../img/main/desktop/01.webp";
import worldArchiveImage from "../img/main/desktop/04.webp";
import logoInline from "../img/logo/logo.svg?raw";

const [news, movies, entries, wiki, doujin] = await Promise.all([
  getCollectionCards("news"),
  getMovieEntries(),
  getCollectionCards("entries"),
  getCollectionCards("wiki"),
  getCollectionCards("doujin"),
]);

const publishedNews = news.filter((item) => item.slug !== "2026-01-09-init");
const latestNews = publishedNews.slice(0, 4);
const latestSignal = latestNews[0];
const featuredMovies = movies.slice(0, 2).map((movie) => ({
  ...movie,
  bvid:
    ({
      "xita-yunhaizhujing": "BV1HUq5BqErE",
      "xita-yunshangyoucha": "BV1894y167kr",
    } as Record<string, string>)[movie.slug] ?? movie.link.match(/BV[a-zA-Z0-9]+/)?.[0],
}));
const worldEntries = entries.slice(0, 3);
const latestDoujin = doujin.slice(0, 4);

const jsonLd = [
  {
    "@context": "https://schema.org",
    "@type": "CollectionPage",
    name: SITE_TITLE,
    description: SITE_DESCRIPTION,
    url: new URL(Astro.url.pathname, Astro.site).toString(),
    inLanguage: "zh-CN",
    keywords: SITE_KEYWORDS.join(", "),
  },
  buildBreadcrumbJsonLd([{ name: "首页", path: "/" }]),
];
---

<BaseLayout title={SITE_TITLE} description={SITE_DESCRIPTION} keywords={SITE_KEYWORDS} jsonLd={jsonLd} bodyClass="home-page">
  <div class="page-loader" data-page-loader aria-hidden="true">
    <span>CETUS</span>
    <i></i>
  </div>

  <SiteHeader overlay />

  <main id="main-content">
    <section class="home-hero" id="top" data-hero>
      <picture class="home-hero__media" data-hero-media>
        <source media="(max-width: 760px)" srcset={toAssetSrc(heroMobile)} />
        <img src={toAssetSrc(heroDesktop)} alt="云海之上的汐塔世界" fetchpriority="high" />
      </picture>
      <div class="home-hero__wash" aria-hidden="true"></div>
      <div class="home-hero__content">
        <div class="home-hero__logo" set:html={logoInline} aria-label="汐塔"></div>
        <p class="home-hero__lead">自天空坠落云海，随潮汐回归彼岸</p>
        <div class="home-hero__actions">
          <a class="button button--light" href="#news">NEWS</a>
          <a class="button button--glass" href="/wiki/">WIKI</a>
        </div>
      </div>
      <div class="home-hero__orb" aria-hidden="true"></div>
      <div class="home-hero__caption" aria-hidden="true">
        <span>42 / CETUS</span>
        <span>ABOVE THE CLOUD SEA</span>
      </div>
      <a class="scroll-cue" href="#signal" aria-label="向下浏览"><span></span>SCROLL</a>
    </section>

    {latestSignal ? (
      <aside class="dispatch-strip" id="signal" aria-label="最新动态">
        <span class="dispatch-strip__label">NEW</span>
        <a href={latestSignal.url}>
          <time>{formatDate(latestSignal.date)}</time>
          <strong>{latestSignal.title}</strong>
          <span>READ ↗</span>
        </a>
        <a class="dispatch-strip__official" href="https://space.bilibili.com/3493270525053175/dynamic" target="_blank" rel="noreferrer">OFFICIAL ↗</a>
      </aside>
    ) : null}

    <section class="manifesto-section" aria-label="汐塔世界" data-reveal>
      <div class="manifesto-section__copy section-pad">
        <p class="micro-label">CETUS / WORLD</p>
        <h1>云海之上，<br /><em>孤岛新生。</em></h1>
        <dl>
          <div><dt>{wiki.length}</dt><dd>WIKI</dd></div>
          <div><dt>{doujin.length}</dt><dd>DOUJIN</dd></div>
          <div><dt>{publishedNews.length}</dt><dd>NEWS</dd></div>
        </dl>
      </div>
      <div class="manifesto-section__image" data-parallax>
        <img src={toAssetSrc(worldImage)} alt="潮汐塔与探险者" loading="lazy" />
        <span aria-hidden="true">汐塔</span>
      </div>
    </section>

    <section class="news-section section-pad" id="news" aria-labelledby="news-title">
      <header class="section-title" data-reveal>
        <p class="micro-label">LATEST DISPATCH</p>
        <h2 id="news-title">NEWS</h2>
        <a href="/news/">ALL NEWS ↗</a>
      </header>
      <div class="news-grid">
        {latestNews.map((item, index) => (
          <a class:list={["signal-card", `signal-card--tone-${(index % 4) + 1}`]} href={item.url} data-reveal style={`--delay:${index * 70}ms`}>
            <div class="signal-card__media">
              {item.cover ? <img src={item.cover} alt="" loading="lazy" /> : <span aria-hidden="true">C</span>}
            </div>
            <div class="signal-card__body">
              <div class="signal-card__meta"><time>{formatDate(item.date)}</time><span>0{index + 1}</span></div>
              <h3>{item.title}</h3>
              {item.description ? <p>{item.description}</p> : null}
              <span class="signal-card__arrow">OPEN ↗</span>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="film-section" id="movies" aria-labelledby="film-title">
      <div class="film-section__flare" aria-hidden="true"></div>
      <div class="film-section__inner section-pad">
        <header class="section-title section-title--light" data-reveal>
          <p class="micro-label">MOVING IMAGE</p>
          <h2 id="film-title">MOVIES</h2>
          <a href="https://space.bilibili.com/3493270525053175/upload" target="_blank" rel="noreferrer">BILIBILI ↗</a>
        </header>
        <div class="film-grid">
          {featuredMovies.map((movie, index) => (
            <button
              class:list={["film-card", index === 0 && "film-card--main"]}
              type="button"
              data-video-open
              data-video-id={movie.bvid}
              data-video-title={movie.title}
              aria-label={`播放 ${movie.title}`}
              data-reveal
              style={`--delay:${index * 110}ms`}
            >
              <span class="film-card__image">
                <img src={movie.cover} alt="" loading="lazy" />
                <span class="film-card__play" aria-hidden="true"><i></i></span>
                <span class="film-card__number">0{index + 1}</span>
              </span>
              <span class="film-card__info">
                <time>{formatDate(movie.date)}</time>
                <strong>{movie.title}</strong>
                {movie.description ? <small>{movie.description}</small> : null}
              </span>
            </button>
          ))}
        </div>
      </div>
    </section>

    <section class="world-section" id="wiki" aria-labelledby="world-title">
      <div class="world-section__marquee" aria-hidden="true"><span>FIELD GUIDE · FIELD GUIDE · FIELD GUIDE ·</span></div>
      <div class="world-section__inner section-pad">
        <header class="section-title" data-reveal>
          <p class="micro-label">WORLD INDEX</p>
          <h2 id="world-title">WIKI</h2>
          <a href="/wiki/">ALL ENTRIES ↗</a>
        </header>
        <div class="world-feature">
          <div class="world-feature__image" data-reveal>
            <img src={toAssetSrc(worldArchiveImage)} alt="云海世界" loading="lazy" />
            <span aria-hidden="true">CETUS</span>
          </div>
          <div class="world-feature__entries">
            {worldEntries.map((entry, index) => (
              <a href={entry.url} data-reveal style={`--delay:${index * 80}ms`}>
                <span>0{index + 1}</span>
                <div>
                  <h3>{entry.title}</h3>
                  {entry.summary || entry.description ? <p>{entry.summary ?? entry.description}</p> : null}
                </div>
                <b aria-hidden="true">↗</b>
              </a>
            ))}
            <a class="world-feature__all" href="/entries/">ALL ENTRIES <b>↗</b></a>
          </div>
        </div>
      </div>
    </section>

    <section class="doujin-section" id="doujin" aria-labelledby="doujin-title">
      <div class="doujin-section__inner section-pad">
        <header class="section-title section-title--light" data-reveal>
          <p class="micro-label">FAN CREATIONS</p>
          <h2 id="doujin-title">DOUJIN</h2>
          <a href="/doujin/">ALL WORKS ↗</a>
        </header>
        <div class="doujin-grid">
          {latestDoujin.map((item, index) => (
            <a href={item.url} data-reveal style={`--delay:${index * 70}ms`}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <h3>{item.title}</h3>
              <b>READ ↗</b>
            </a>
          ))}
        </div>
      </div>
    </section>

    <nav class="route-grid" aria-label="档案分类">
      <a href="/news/" data-reveal><span>01</span><strong>NEWS</strong><b>↗</b></a>
      <a href="/wiki/" data-reveal><span>02</span><strong>WIKI</strong><b>↗</b></a>
      <a href="/doujin/" data-reveal><span>03</span><strong>DOUJIN</strong><b>↗</b></a>
      <a href="/music" data-reveal><span>04</span><strong>MUSIC</strong><b>↗</b></a>
    </nav>
  </main>

  <dialog class="video-modal" data-video-dialog aria-labelledby="video-modal-title">
    <div class="video-modal__panel">
      <header>
        <p id="video-modal-title">MOVIE</p>
        <button type="button" data-video-close aria-label="关闭视频">CLOSE <span aria-hidden="true">×</span></button>
      </header>
      <div class="video-modal__frame">
        <iframe
          data-video-frame
          title="哔哩哔哩视频播放器"
          scrolling="no"
          frameborder="0"
          allow="autoplay; fullscreen; picture-in-picture"
          allowfullscreen
          referrerpolicy="strict-origin-when-cross-origin"
        ></iframe>
      </div>
    </div>
  </dialog>

  <HomeFooter />
</BaseLayout>
